{
  "manifest_version": 3,
  "name": "유튜브 링크 정리",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "유튜브 공유 창, 링크 미리보기, 복사·공유 주소에서 불필요한 인자를 제거합니다. 시작 시간은 유지합니다.",
  "permissions": ["activeTab", "clipboardWrite", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*"],
  "declarative_net_request": {"rule_resources": [{"id": "incoming_links", "enabled": true, "path": "rules/incoming.json"}]},
  "action": {
    "default_title": "유튜브 링크 정리",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*"],
    "js": ["cleaner.js", "page.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true
  }]
}
