{
  "manifest_version": 3,
  "name": "클린 링크 for YouTube™",
  "short_name": "클린 링크",
  "version": "1.1.1",
  "minimum_chrome_version": "111",
  "description": "YouTube™ 영상 링크의 추적 인자를 공유·복사·열기 전에 정리하고 시작 시간은 유지합니다.",
  "homepage_url": "https://github.com/leaddwk/Youtube-Clean-Link",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"},
  "permissions": ["activeTab", "clipboardWrite", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*"],
  "declarative_net_request": {"rule_resources": [{"id": "incoming_links", "enabled": true, "path": "rules/incoming.json"}]},
  "action": {
    "default_title": "클린 링크 for YouTube™",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*", "*://youtu.be/*", "*://*.youtube-nocookie.com/*"],
    "js": ["cleaner.js", "page.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true
  }]
}
